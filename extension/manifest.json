{
  "manifest_version": 3,
  "name": "Taghvim — Jalali & Gregorian New Tab",
  "short_name": "Taghvim",
  "version": "1.5.0",
  "description": "A new tab page with the Jalali and Gregorian calendars, and holidays with descriptions and images from a public GitHub repository.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "taghvim@1995parham.github.io",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
